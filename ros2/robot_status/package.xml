<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_status</name>
  <version>0.2.0</version>
  <description>Fleet robot nodes in C++: status_node publishes battery, sonar and system status;
    command_node executes motion, servo, LED and buzzer commands with safety limits.</description>
  <maintainer email="hmarthens@gmail.com">hmarthens1</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <!-- System libraries, installed by scripts/install_status_service.sh:
       nlohmann-json3-dev, libgpiod-dev, git (rpi_ws281x is fetched at build time) -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
