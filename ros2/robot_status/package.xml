<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_status</name>
  <version>0.1.0</version>
  <description>Publishes battery, ultrasonic range and system status of a fleet robot (read-only).</description>
  <maintainer email="hmarthens@gmail.com">hmarthens1</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- robot_board (the Python package in this repo) is installed with pip: scripts/install.sh -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
