<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS without shared memory: UDP only (also between nodes on the same Pi).

     vision_node runs as the normal user and command_node as root (for the RGB LEDs).
     Fast DDS uses shared memory between processes on one machine, and root's segments in
     /dev/shm are read-only for other users: discovery works, but vision_node's cmd_vel and
     arm commands never reach command_node (robot01, 2026-09-28: lane following "followed"
     and the robot did not move). With one side UDP-only, the pair talks over loopback UDP. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
