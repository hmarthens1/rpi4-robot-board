<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_vision</name>
  <version>0.1.0</version>
  <description>The robot's USB camera in C++: colour lane tracking and following with OpenCV,
    and YOLOX object detection with ncnn.</description>
  <maintainer email="hmarthens@gmail.com">hmarthens1</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- System libraries, installed by scripts/install_vision.sh:
       libopencv-dev (apt), nlohmann-json3-dev (apt), ncnn (built from source) -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
